{
  "name": "@kitsune/desktop",
  "version": "0.1.0",
  "description": "Aplicativo desktop local-first para catálogo e reprodução de anime.",
  "author": "Kitsune contributors",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "electron-vite build",
    "build:win": "corepack pnpm build && electron-builder --win nsis",
    "build:portable": "corepack pnpm build && electron-builder --win portable",
    "verify:bin": "node scripts/verify-binaries.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "webtorrent": "3.0.21",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/webtorrent": "0.110.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "dev.kitsune.desktop",
    "productName": "Kitsune",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-datachannel/**/*"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
